$ todoer add first -l core
.todoer/todos/first.md

$ todoer add second -l core -d first
.todoer/todos/second.md

$ todoer add third -d second
.todoer/todos/third.md

$ todoer claim
exit code: 1
--- stderr
error: name a todo or a label - use todoer claim <name>... [--label l] [--force] [--no-commit]

$ todoer claim second
exit code: 1
--- stderr
error: second waits for first - claim a todo that is not blocked, claim it together with the todos that it waits for, or use --force

$ todoer claim first
claimed first for me@example.com

$ todoer claim first
first is already claimed by you

$ git log --format=%s -1 && git status --short
todoer: claim first

--- .todoer/todos/first.md
---
labels: [core]
assignee: me@example.com
---

$ git config user.email other@example.com && todoer claim first
exit code: 1
--- stderr
error: first is claimed by me@example.com - pick another todo, or ask me@example.com to run todoer unclaim

$ todoer claim --label core
exit code: 1
skipped first: claimed by me@example.com
--- stderr
error: second waits for first - claim a todo that is not blocked, claim it together with the todos that it waits for, or use --force

$ todoer claim third
exit code: 1
--- stderr
error: third waits for second - claim a todo that is not blocked, claim it together with the todos that it waits for, or use --force

$ todoer claim third second
exit code: 1
--- stderr
error: second waits for first - claim a todo that is not blocked, claim it together with the todos that it waits for, or use --force

$ git log --format=%s -1 && git status --short
todoer: claim first

$ git config user.email me@example.com && todoer ls --mine
in-progress  first  me@example.com

$ todoer claim --label nope
exit code: 1
--- stderr
error: no todo has the label nope - run todoer labels

$ todoer unclaim first
unclaimed first (was me@example.com)

$ todoer unclaim first
exit code: 1
--- stderr
error: first is not claimed

$ git log --format=%s -1 && git status --short
todoer: unclaim first

--- .todoer/todos/first.md
---
labels: [core]
---

$ todoer claim first && git log --format=%s -1 && git status --short
claimed first for me@example.com
notes
 M .todoer/todos/first.md
 M notes.txt
--- stderr
warning: not committed - the checkout has other changes: notes.txt. The changes of todoer are in the working tree. Commit them yourself

$ todoer unclaim first --no-commit && git status --short
unclaimed first (was me@example.com)
not committed (--no-commit) - the changes are in the working tree

$ todoer ls [cwd: feature]
available    first
blocked      second  waits for first
blocked      third   waits for second

$ todoer claim first && git log --format=%s -1 && git status --short [cwd: feature]
claimed first for me@example.com
todoer: claim first

