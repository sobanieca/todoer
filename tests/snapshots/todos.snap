]

$ cd .todoer/todos && todoer claim port-cli-parser.md
claimed port-cli-parser for me@example.com

$ todoer ls
in-progress  port-cli-parser  me@example.com
blocked      port-config      waits for port-cli-parser
blocked      release-v1       waits for port-config

$ todoer dep show port-config
port-config  (blocked)

waits for:
  port-cli-parser  (in-progress)

needed by:
  release-v1  (blocked)

$ todoer dep add port-cli-parser release-v1
exit code: 1
--- stderr
error: port-cli-parser cannot depend on release-v1 - release-v1 already depends on port-cli-parser, so this makes a cycle

$ todoer dep add release-v1 release-v1
exit code: 1
--- stderr
error: release-v1 cannot depend on itself

$ todoer dep add release-v1 port-cli-parser
release-v1 depends on port-cli-parser

$ todoer dep show port-cli-parser
port-cli-parser  (in-progress)

waits for:
  nothing

needed by:
  port-config  (blocked)
    release-v1  (blocked)
  release-v1  see above

$ todoer dep rm release-v1 port-cli-parser
release-v1 no longer depends on port-cli-parser

$ todoer dep rm release-v1 port-cli-parser
exit code: 1
--- stderr
error: release-v1 does not depend on port-cli-parser

