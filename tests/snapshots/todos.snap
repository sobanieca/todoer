$ cd todo/rust && todoer add -t 'Port the CLI parser' -l rust-port 'Parse the arguments.'
todo/rust/port-the-cli-parser.md

$ todoer add -t 'Port: the config' -p todo/rust -l rust-port -l config -d todo/rust/port-the-cli-parser.md
todo/rust/port-the-config.md

$ echo 'From stdin.' | todoer add -t 'Release v1' -p todo -d todo/rust/port-the-config.md
todo/release-v1.md

$ todoer add -t 'Port the CLI parser' -p todo/rust
todo/rust/port-the-cli-parser-2.md

$ todoer add 'no title'
exit code: 1
--- stderr
error: a todo needs a title - use todoer add -t "<title>" [text]

$ todoer add -t x -l Bad
exit code: 1
--- stderr
error: "Bad" is not a label - use lowercase letters, digits and hyphens

$ todoer add -t x -d todo/missing.md
exit code: 1
--- stderr
error: there is no todo todo/missing.md - run todoer ls

--- todo/rust/port-the-config.md
---
title: "Port: the config"
status: todo
labels: [rust-port, config]
dependsOn: [todo/rust/port-the-cli-parser.md]
---

--- todo/release-v1.md
---
title: Release v1
status: todo
dependsOn: [todo/rust/port-the-config.md]
---

